# OpenAI Realtime API
OPENAI_API_KEY=
OPENAI_REALTIME_MODEL=gpt-realtime-mini
OPENAI_REALTIME_VOICE=marin
OPENAI_REALTIME_TRANSCRIPTION_MODEL=gpt-realtime-whisper

# Gemini Live API
GEMINI_API_KEY=
GEMINI_LIVE_MODEL=gemini-3.1-flash-live-preview

# Optional report LLM enhancement
REPORT_LLM_PROVIDER=deepseek
GEMINI_REPORT_MODEL=gemini-3.5-flash
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_REPORT_MODEL=deepseek-v4-flash
DEEPSEEK_ADVANCED_REPORT_MODEL=deepseek-v4-pro
REPORT_LLM_TIMEOUT_SECONDS=20
REPORT_LLM_MAX_TOKENS=1600
ADVANCED_REPORT_LLM_TIMEOUT_SECONDS=90
ADVANCED_REPORT_LLM_MAX_TOKENS=2400

# Azure Speech Pronunciation Assessment
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=

# Backend
DATABASE_URL=sqlite:///./data/coach.db
BACKEND_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Frontend
VITE_API_BASE_URL=http://127.0.0.1:8000
